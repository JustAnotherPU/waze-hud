{
  "id": "jap-waze-on-cluster",
  "kind": "tool",
  "version": "1.1.1",
  "license": "GPL-3.0-or-later",
  "title": "Waze HUD on cluster",
  "description": "Shows the CarPlay or Android Auto map on the instrument cluster and Waze's next turn on BMW's own HUD arrows: a root helper applies the reversible carplay and aapd patches where each is supported, and the capture, running from boot, decodes the map's H.264 and draws it through the cluster renderer whenever the stream flows. Stays off while robertnisipeanu's Waze on cluster is installed",
  "requires": {
    "mgu-deploy": "0.7.11",
    "cluster-render": "0.3.7"
  },
  "uninstallable": true,
  "mguHmi": [
    "ID7"
  ],
  "activate": [
    "node",
    "patchd.js",
    "activate"
  ],
  "deactivate": [
    "node",
    "patchd.js",
    "deactivate"
  ],
  "build": [
    "make",
    "target"
  ],
  "files": [
    {
      "path": "jap-waze-on-cluster",
      "from": "build/target/jap-waze-on-cluster",
      "mode": "0755"
    },
    {
      "path": "jap-waze-on-cluster.conf",
      "from": "jap-waze-on-cluster.conf",
      "mode": "0644"
    },
    {
      "path": "carplay_patch.js",
      "from": "patch/carplay_patch.js",
      "mode": "0644"
    },
    {
      "path": "carplay_locate.js",
      "from": "patch/carplay_locate.js",
      "mode": "0644"
    },
    {
      "path": "aapd_patch.js",
      "from": "patch/aapd_patch.js",
      "mode": "0644"
    },
    {
      "path": "aapd_conf.js",
      "from": "patch/aapd_conf.js",
      "mode": "0644"
    },
    {
      "path": "patchd.js",
      "from": "patch/patchd.js",
      "mode": "0644"
    },
    {
      "path": "conflict.js",
      "from": "patch/conflict.js",
      "mode": "0644"
    },
    {
      "path": "recovery.js",
      "from": "patch/recovery.js",
      "mode": "0644"
    },
    {
      "path": "remount_lock.js",
      "from": "patch/remount_lock.js",
      "mode": "0644"
    },
    {
      "path": "recmgr_list.js",
      "from": "patch/recmgr_list.js",
      "mode": "0644"
    },
    {
      "path": "shutdown_mark.sh",
      "from": "patch/shutdown_mark.sh",
      "mode": "0755"
    },
    {
      "path": "woc-patch.sh",
      "from": "patch/woc-patch.sh",
      "mode": "0755"
    },
    {
      "path": "dlt_capture.js",
      "from": "patch/dlt_capture.js",
      "mode": "0644"
    },
    {
      "path": "journal_keep.js",
      "from": "patch/journal_keep.js",
      "mode": "0644"
    },
    {
      "path": "logs.js",
      "from": "patch/logs.js",
      "mode": "0644"
    },
    {
      "path": "logs_fw.js",
      "from": "patch/logs_fw.js",
      "mode": "0644"
    },
    {
      "path": "group_dir.js",
      "from": "patch/group_dir.js",
      "mode": "0644"
    },
    {
      "path": "collect-logs.sh",
      "from": "tools/collect-logs.sh",
      "mode": "0755"
    },
    {
      "path": "hudguide.js",
      "from": "patch/hudguide.js",
      "mode": "0644"
    },
    {
      "path": "pmg_schema.js",
      "from": "patch/pmg_schema.js",
      "mode": "0644"
    },
    {
      "path": "LICENSE",
      "from": "LICENSE",
      "mode": "0644"
    }
  ],
  "units": [
    {
      "name": "jap-waze-on-cluster.socket",
      "from": "systemd/jap-waze-on-cluster.socket"
    },
    {
      "name": "jap-waze-on-cluster.service",
      "from": "systemd/jap-waze-on-cluster.service"
    },
    {
      "name": "jap-waze-on-cluster-patchd.service",
      "from": "systemd/jap-waze-on-cluster-patchd.service"
    },
    {
      "name": "jap-waze-on-cluster-boot.service",
      "from": "systemd/jap-waze-on-cluster-boot.service"
    },
    {
      "name": "jap-waze-on-cluster-aa-boot.service",
      "from": "systemd/jap-waze-on-cluster-aa-boot.service"
    },
    {
      "name": "jap-waze-on-cluster-recovery.service",
      "from": "systemd/jap-waze-on-cluster-recovery.service"
    },
    {
      "name": "jap-waze-on-cluster-capture.service",
      "from": "systemd/jap-waze-on-cluster-capture.service"
    },
    {
      "name": "jap-waze-on-cluster-journal.service",
      "from": "systemd/jap-waze-on-cluster-journal.service"
    },
    {
      "name": "jap-waze-on-cluster-journal.timer",
      "from": "systemd/jap-waze-on-cluster-journal.timer"
    },
    {
      "name": "jap-waze-on-cluster-logs.socket",
      "from": "systemd/jap-waze-on-cluster-logs.socket"
    },
    {
      "name": "jap-waze-on-cluster-logs.service",
      "from": "systemd/jap-waze-on-cluster-logs.service"
    },
    {
      "name": "jap-waze-on-cluster-logs-fw.service",
      "from": "systemd/jap-waze-on-cluster-logs-fw.service"
    },
    {
      "name": "jap-waze-on-cluster-hudguide.service",
      "from": "systemd/jap-waze-on-cluster-hudguide.service"
    }
  ],
  "enable": [
    {
      "unit": "jap-waze-on-cluster.socket",
      "target": "sockets.target"
    },
    {
      "unit": "jap-waze-on-cluster.service",
      "target": "multi-user.target"
    },
    {
      "unit": "jap-waze-on-cluster-patchd.service",
      "target": "multi-user.target"
    },
    {
      "unit": "jap-waze-on-cluster-boot.service",
      "target": "multi-user.target"
    },
    {
      "unit": "jap-waze-on-cluster-aa-boot.service",
      "target": "multi-user.target"
    },
    {
      "unit": "jap-waze-on-cluster-recovery.service",
      "target": "multi-user.target"
    },
    {
      "unit": "jap-waze-on-cluster-capture.service",
      "target": "multi-user.target"
    },
    {
      "unit": "jap-waze-on-cluster-journal.timer",
      "target": "timers.target"
    },
    {
      "unit": "jap-waze-on-cluster-logs.socket",
      "target": "sockets.target"
    },
    {
      "unit": "jap-waze-on-cluster-hudguide.service",
      "target": "multi-user.target"
    }
  ],
  "dropins": [
    {
      "unit": "var-opt-ro.service",
      "name": "50-jap-waze-on-cluster.conf",
      "from": "systemd/var-opt-ro.service.d/50-jap-waze-on-cluster.conf"
    },
    {
      "unit": "carplay.service",
      "name": "50-jap-waze-on-cluster.conf",
      "from": "systemd/carplay.service.d/50-jap-waze-on-cluster.conf"
    }
  ],
  "recmgr": [
    "carplay",
    "aapd",
    "jap-waze-on-cluster",
    "jap-waze-on-cluster-patchd",
    "jap-waze-on-cluster-boot",
    "jap-waze-on-cluster-aa-boot",
    "jap-waze-on-cluster-recovery",
    "jap-waze-on-cluster-capture",
    "jap-waze-on-cluster-journal",
    "jap-waze-on-cluster-logs",
    "jap-waze-on-cluster-logs-fw",
    "jap-waze-on-cluster-hudguide"
  ],
  "crashNames": [
    "aapd"
  ],
  "restart": [
    "jap-waze-on-cluster.service",
    "jap-waze-on-cluster-patchd.service",
    "jap-waze-on-cluster-recovery.service",
    "jap-waze-on-cluster-capture.service",
    "jap-waze-on-cluster-journal.service",
    "jap-waze-on-cluster-hudguide.service"
  ]
}
