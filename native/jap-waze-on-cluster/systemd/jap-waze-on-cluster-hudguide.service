[Unit]
Description=jap-waze-on-cluster HUD guidance: Waze's next turn to BMW's own HUD arrows (ProjectedModeGuiding), as carplay sends Apple's and Google's
RequiresMountsFor=/var/opt
# Dormant while robertnisipeanu's waze-on-cluster is installed (patch/conflict.js).
ConditionPathExists=!/var/opt/waze-on-cluster/current/component.json
After=local-fs.target jap-waze-on-cluster.service
# A start that fails (no navigation, a changed interface file) is retried
# every 30 s, at most 5 times in 10 min, then left failed.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
# carplay's own user: the navigation's SOME/IP services answer it (VERIFIED
# on the car as cia_13002; they refuse hmi_5000), so no root. It reads
# /run/jap-waze-on-cluster/hud.json, which jap-waze-on-cluster writes only with
# hud_backend = native; without it the file is absent and this sends
# nothing. On stop it clears what it sent (INACTIVE), within 4 s.
User=cia_13002
Group=cia_13002
ExecStart=/usr/bin/node /var/opt/jap-waze-on-cluster/current/hudguide.js
Restart=on-failure
RestartSec=30
NoNewPrivileges=yes
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
