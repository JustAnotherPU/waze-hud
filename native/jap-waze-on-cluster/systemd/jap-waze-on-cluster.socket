[Unit]
Description=jap-waze-on-cluster control socket
# Dormant while robertnisipeanu's waze-on-cluster is installed (patch/conflict.js).
ConditionPathExists=!/var/opt/waze-on-cluster/current/component.json

[Socket]
# The render's status and log for the iDrive app. jap-waze-on-cluster.service runs
# from boot; a connection also starts it if it is not running. systemd creates
# the directory each boot.
ListenStream=/dev/shm/jap-waze-on-cluster/ctl.sock
DirectoryMode=0755
SocketMode=0660
# Every OAP app process has tm_oap_app as a supplementary group, so the iDrive
# app can open the socket.
SocketGroup=tm_oap_app

[Install]
WantedBy=sockets.target
